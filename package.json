{
  "name": "discord-tools-public",
  "version": "0.1.0",
  "private": true,
  "description": "Generic Discord MCP server and Discord gateway examples.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/discord-mcp",
    "packages/discord-gateway"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
