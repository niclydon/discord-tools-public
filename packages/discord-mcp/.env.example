# Transport: http for a local HTTP MCP endpoint, or stdio for local agent clients.
TRANSPORT=http

# HTTP transport listen port. The server binds to 127.0.0.1.
PORT=7871

# Discord bot credentials from the Discord Developer Portal.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Optional shared secret for reverse proxies or tunnels. Unset = local dev.
ORIGIN_SHARED_SECRET=

NODE_ENV=development
LOG_LEVEL=normal
